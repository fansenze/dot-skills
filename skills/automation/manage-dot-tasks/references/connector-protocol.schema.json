{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dot-tasks:connector:1",
  "title": "Manage Dot Tasks connector protocol 1",
  "$defs": {
    "format": {
      "enum": [
        "text",
        "markdown",
        "card"
      ]
    },
    "capabilities": {
      "type": "object",
      "required": [
        "protocol_version",
        "name",
        "formats",
        "send",
        "reply",
        "receive",
        "durable_cursor"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/format"
          }
        },
        "send": {
          "type": "boolean"
        },
        "reply": {
          "type": "boolean"
        },
        "receive": {
          "type": "boolean"
        },
        "durable_cursor": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": [
        "title",
        "updated_at",
        "columns",
        "rows",
        "details"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "response": {
          "$ref": "#/$defs/response"
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": [
        "account_id",
        "destination",
        "format",
        "body",
        "reply_to",
        "idempotency_key"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "destination": {
          "type": "object",
          "required": [
            "id",
            "type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "additionalProperties": false
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "body": {
          "type": [
            "string",
            "object"
          ]
        },
        "reply_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "reply_in_thread": {
          "type": "boolean",
          "description": "Optional frozen thread reply flag; absent preserves legacy false."
        }
      },
      "additionalProperties": false
    },
    "send_result": {
      "type": "object",
      "required": [
        "status",
        "idempotency_key"
      ],
      "properties": {
        "status": {
          "enum": [
            "api_accepted",
            "not_sent",
            "api_error",
            "delivery_unknown"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "retryable": {
          "type": "boolean"
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "request_phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "code": {
          "type": "integer"
        },
        "http_status": {
          "type": "integer"
        },
        "elapsed_ms": {
          "type": "integer"
        },
        "parent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Provider envelope context only; never task authority."
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Provider envelope context only; never task authority."
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Provider envelope context only; never task authority."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "api_accepted"
              }
            }
          },
          "then": {
            "required": [
              "message_id"
            ]
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "cursor",
        "event_id",
        "message_id",
        "account_id",
        "tenant_id",
        "destination_id",
        "type",
        "received_at"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "destination_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sender_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sender_tenant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string"
        },
        "received_at": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$",
          "description": "Optional exact provider envelope context; not identity or authorization evidence."
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$",
          "description": "Optional exact provider envelope context; not identity or authorization evidence."
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$",
          "description": "Optional exact provider envelope context; not identity or authorization evidence."
        },
        "brand": {
          "type": "string",
          "maxLength": 256
        },
        "chat_type": {
          "type": "string",
          "maxLength": 256
        },
        "sender_type": {
          "type": "string",
          "maxLength": 256
        },
        "native_text": {
          "type": "string",
          "maxLength": 8000
        },
        "provider_app_id": {
          "type": "string",
          "maxLength": 256
        },
        "provider_event_id": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "events",
        "next_cursor",
        "has_more"
      ],
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "response_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://[^\\s<>]+$",
      "format": "uri",
      "description": "HTTP(S) URL without embedded credentials. Runtime URL parsing additionally rejects credentials and invalid hosts."
    },
    "response": {
      "type": "object",
      "required": [
        "template",
        "lead"
      ],
      "properties": {
        "template": {
          "enum": [
            "ack",
            "list",
            "detail",
            "decision",
            "brief"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069\\u0009\\u000a\\u000d]+$"
        },
        "lead": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "blocker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "next_action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "url": {
                "$ref": "#/$defs/response_url"
              }
            },
            "additionalProperties": false
          }
        },
        "sections": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "title",
              "items"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "items": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "links": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "url": {
                "$ref": "#/$defs/response_url"
              }
            },
            "additionalProperties": false
          }
        },
        "options": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
              }
            },
            "additionalProperties": false
          }
        },
        "data_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?(?:Z|[+-]\\d\\d:\\d\\d)$",
          "description": "Runtime checks calendar validity and rejects normalized impossible dates."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
        },
        "coverage": {
          "type": "object",
          "required": [
            "shown",
            "total"
          ],
          "properties": {
            "shown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "format_override": {
          "type": "object",
          "required": [
            "format",
            "authorization_ref"
          ],
          "properties": {
            "format": {
              "$ref": "#/$defs/format"
            },
            "authorization_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069\\u0009\\u000a\\u000d]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Plain-content presentation. Serialized response is at most 24576 UTF-8 bytes; selected rendered JSON is at most 28000 bytes. Runtime validates byte limits, coverage.shown equals items.length, coverage.total >= shown, supported format, and format authorization reference equals the current incoming message or scoped claim ID.",
      "allOf": [
        {
          "if": {
            "properties": {
              "template": {
                "const": "ack"
              }
            }
          },
          "then": {
            "properties": {
              "template": {
                "enum": [
                  "ack",
                  "list",
                  "detail",
                  "decision",
                  "brief"
                ]
              },
              "lead": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069\\u0009\\u000a\\u000d]+$"
              },
              "format_override": {
                "type": "object",
                "required": [
                  "format",
                  "authorization_ref"
                ],
                "properties": {
                  "format": {
                    "$ref": "#/$defs/format"
                  },
                  "authorization_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069\\u0009\\u000a\\u000d]+$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "list"
              }
            }
          },
          "then": {
            "required": [
              "items",
              "coverage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "decision"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "description"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160,
                      "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "^(?!\\s*$)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]+$"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "template": {
                "const": "brief"
              }
            }
          },
          "then": {
            "required": [
              "data_time",
              "source"
            ]
          }
        }
      ]
    }
  }
}
